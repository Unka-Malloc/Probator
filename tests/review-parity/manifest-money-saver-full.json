[
  {
    "name": "money_context",
    "description": "Inspect the immutable snapshot. Start with inventory for mode and scope, then original_request (the review charter); list/find glob and page the snapshot, read returns numbered source. Full-mode find supports literal alternatives separated by |. No source execution or production access.",
    "parameters": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "inventory",
            "original_request",
            "list",
            "read",
            "find"
          ]
        },
        "path": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "start": {
          "type": "integer"
        },
        "offset": {
          "type": "integer"
        },
        "revision": {
          "type": "string",
          "enum": [
            "staged",
            "base"
          ]
        }
      },
      "required": [
        "operation"
      ]
    }
  },
  {
    "name": "money_official_doc",
    "description": "Fetch an official reference by catalog key, listed URL, or an https page on a host the catalog already names - an unlisted page on a catalog host is allowed; query and fragment are not. Cached once per review; offset pages through the same response.",
    "parameters": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "offset": {
          "type": "integer"
        }
      },
      "required": [
        "name"
      ]
    }
  },
  {
