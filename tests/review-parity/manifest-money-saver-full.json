            "continuity": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "reviewed",
                    "not-applicable",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string"
                }
